  section
    h3 "Comments"
    # ! load only a few top comments, then show more link
    # ? What does "Top comment" mean
    TextArea label="Comment"
    button "Submit"
    section style="margin: 0 12px"
      section style="display:flex"
        img src="http://placehold.co/50"
        section style="display:flex; flex-direction: column"
          p style="margin:0; padding: 0" "UserName"
          p style="margin:0; padding: 0" "00/00/00 00:00am"
      p "Comment text"
      button "👍 0"
      button "👎 0"
      button "reply"
      button "share"
      a "Report comment"
      section style="border-left: 1px solid black; padding: 12px 50px; margin: 0 12px"
